<Application x:Class="Cropwell.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose"
             ThemeMode="System">
  <Application.Resources>
    <Style x:Key="CommandButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinWidth" Value="38" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Margin" Value="2" />
    </Style>
    <Style x:Key="DialogButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinWidth" Value="88" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Margin" Value="4,0,0,0" />
    </Style>
    <Style x:Key="CropModeToggleStyle" TargetType="ToggleButton">
      <Setter Property="MinWidth" Value="58" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
          <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
