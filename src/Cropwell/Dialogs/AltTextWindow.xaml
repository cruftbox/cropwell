<Window x:Class="Cropwell.Dialogs.AltTextWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alt text" Width="560" Height="360" MinWidth="440" MinHeight="300" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Alt text" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,5" />
    <TextBlock x:Name="ProviderText" Grid.Row="1" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,0,0,14" />
    <Grid Grid.Row="2">
      <TextBox x:Name="TextBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
               Padding="10" AutomationProperties.Name="Generated alt text" />
      <Border x:Name="BusyPanel" Visibility="Collapsed" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
              BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1"
              CornerRadius="6" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <ProgressBar IsIndeterminate="True" Width="180" Height="4" />
          <TextBlock Text="Generating alt text…" HorizontalAlignment="Center" Margin="0,12,0,0" />
        </StackPanel>
      </Border>
    </Grid>
    <TextBlock x:Name="StaleText" Grid.Row="3" Foreground="#FF9A5B00" Margin="0,8,0,0"
               AutomationProperties.LiveSetting="Polite" />
    <StackPanel Grid.Row="4" Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Content="Cancel generation" Click="Cancel_Click" Visibility="Collapsed"
              Style="{DynamicResource DialogButtonStyle}" />
      <Button Content="Copy" Click="Copy_Click" ToolTip="Copy alt text" AutomationProperties.Name="Copy alt text"
              Style="{DynamicResource DialogButtonStyle}" />
      <Button x:Name="RegenerateButton" Content="Regenerate" Click="Regenerate_Click"
              Style="{DynamicResource AccentButtonStyle}" MinWidth="100" MinHeight="34" Padding="12,5" Margin="8,0,0,0" />
    </StackPanel>
  </Grid>
</Window>
