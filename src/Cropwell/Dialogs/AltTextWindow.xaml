<Window x:Class="Cropwell.Dialogs.AltTextWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alt text" Width="480" Height="250" MinWidth="380" MinHeight="210" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel x:Name="BusyPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,8">
      <ProgressBar IsIndeterminate="True" Width="100" Height="10" Margin="0,0,10,0" />
      <TextBlock Text="Generating alt text…" VerticalAlignment="Center" />
    </StackPanel>
    <TextBox x:Name="TextBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Generated alt text" />
    <TextBlock x:Name="StaleText" Grid.Row="2" Foreground="#FF9A5B00" Margin="0,5,0,0" />
    <DockPanel Grid.Row="3" Margin="0,8,0,0">
      <TextBlock x:Name="ProviderText" Foreground="#FF666666" VerticalAlignment="Center" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed" />
        <Button Content="Copy" Click="Copy_Click" ToolTip="Copy alt text" AutomationProperties.Name="Copy alt text" />
        <Button x:Name="RegenerateButton" Content="Regenerate" Click="Regenerate_Click" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
