<Window x:Class="Cropwell.Dialogs.SettingsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="18" MinWidth="440">
    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
    <TextBlock Text="Provider" Margin="0,0,12,10" VerticalAlignment="Center" />
    <ComboBox x:Name="ProviderBox" Grid.Column="1" DisplayMemberPath="Value.DisplayName" SelectedValuePath="Key" SelectionChanged="ProviderChanged" Margin="0,0,0,10" AutomationProperties.Name="Alt text provider" />
    <TextBlock Grid.Row="1" Text="Model" Margin="0,0,12,10" VerticalAlignment="Center" />
    <TextBox x:Name="ModelBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" AutomationProperties.Name="Model name" />
    <TextBlock Grid.Row="2" Text="Base URL" Margin="0,0,12,10" VerticalAlignment="Center" />
    <TextBox x:Name="BaseUrlBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" AutomationProperties.Name="Base URL" />
    <TextBlock Grid.Row="3" Text="API key" Margin="0,0,12,6" VerticalAlignment="Center" />
    <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,6">
      <Button x:Name="ValidateKeyButton" DockPanel.Dock="Right" Content="Validate key" Click="ValidateKey_Click" />
      <PasswordBox x:Name="KeyBox" PasswordChanged="KeyChanged" Margin="0,2,6,2" AutomationProperties.Name="API key" />
    </DockPanel>
    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="KeySourceText" Foreground="#FF666666" Margin="0,0,0,12" />
    <TextBlock Grid.Row="5" Grid.ColumnSpan="2" x:Name="StatusText" Foreground="Firebrick" Margin="0,0,0,8" TextWrapping="Wrap" />
    <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" IsCancel="True" />
      <Button x:Name="SaveButton" Content="Save" IsDefault="True" Click="Save_Click" />
    </StackPanel>
  </Grid>
</Window>
