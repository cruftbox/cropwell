<Window x:Class="Cropwell.Dialogs.CaptureOverlay" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cropwell capture" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Background="Black" Cursor="Cross" UseLayoutRounding="True" KeyDown="OnKeyDown">
  <Grid x:Name="Surface" Background="Transparent" SizeChanged="Surface_SizeChanged"
        MouseLeftButtonDown="Surface_MouseLeftButtonDown" MouseMove="Surface_MouseMove" MouseLeftButtonUp="Surface_MouseLeftButtonUp">
    <Image x:Name="Frame" Stretch="Fill" />
    <Path x:Name="Dim" Fill="#80000000" />
    <Rectangle x:Name="SelectionBox" Stroke="White" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top"
               Visibility="Collapsed" IsHitTestVisible="False" />
  </Grid>
</Window>
