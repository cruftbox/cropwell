<Window x:Class="Cropwell.Dialogs.DiscardDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unsaved edits" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24" MinWidth="430">
    <TextBlock Text="Unsaved edits" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
    <TextBlock Text="This image has edits that have not been exported." Margin="0,0,0,4" />
    <TextBlock Text="Export the image before discarding those edits?"
               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,0,0,22" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" IsCancel="True" Style="{DynamicResource DialogButtonStyle}" />
      <Button Content="Discard" Click="Discard_Click" Style="{DynamicResource DialogButtonStyle}" />
      <Button Content="Export" IsDefault="True" Click="Export_Click" Style="{DynamicResource AccentButtonStyle}"
              MinWidth="88" MinHeight="34" Padding="12,5" Margin="8,0,0,0" />
    </StackPanel>
  </StackPanel>
</Window>
