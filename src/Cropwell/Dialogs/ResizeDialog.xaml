<Window x:Class="Cropwell.Dialogs.ResizeDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resize" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="24" MinWidth="360">
    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <TextBlock Text="Resize image" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,6" />
    <TextBlock Grid.Row="1" Text="Changing either dimension preserves the current aspect ratio."
               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,0,0,18" />
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Width (px)" FontWeight="SemiBold" Margin="0,0,0,5" />
        <TextBox x:Name="WidthBox" TextChanged="WidthChanged" AutomationProperties.Name="Width in pixels" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="Height (px)" FontWeight="SemiBold" Margin="0,0,0,5" />
        <TextBox x:Name="HeightBox" TextChanged="HeightChanged" AutomationProperties.Name="Height in pixels" />
      </StackPanel>
    </Grid>
    <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="Firebrick" Margin="0,10,0,14"
               AutomationProperties.LiveSetting="Polite" />
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" IsCancel="True" Style="{DynamicResource DialogButtonStyle}" />
      <Button Content="Resize" IsDefault="True" Click="Resize_Click" Style="{DynamicResource AccentButtonStyle}"
              MinWidth="88" MinHeight="34" Padding="12,5" Margin="8,0,0,0" />
    </StackPanel>
  </Grid>
</Window>
