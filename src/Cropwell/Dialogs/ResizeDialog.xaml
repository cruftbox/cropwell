<Window x:Class="Cropwell.Dialogs.ResizeDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resize" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="18" MinWidth="310">
    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
    <TextBlock Text="Width (px)" VerticalAlignment="Center" Margin="0,0,12,8" />
    <TextBox x:Name="WidthBox" Grid.Column="1" Margin="0,0,0,8" TextChanged="WidthChanged" AutomationProperties.Name="Width in pixels" />
    <TextBlock Grid.Row="1" Text="Height (px)" VerticalAlignment="Center" Margin="0,0,12,8" />
    <TextBox x:Name="HeightBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" TextChanged="HeightChanged" AutomationProperties.Name="Height in pixels" />
    <TextBlock x:Name="ErrorText" Grid.Row="2" Grid.ColumnSpan="2" Foreground="Firebrick" Margin="0,2,0,8" />
    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" IsCancel="True" />
      <Button Content="Resize" IsDefault="True" Click="Resize_Click" />
    </StackPanel>
  </Grid>
</Window>
