<Window x:Class="Cropwell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cropwell.Controls"
        Title="Cropwell" Width="1100" Height="760" MinWidth="720" MinHeight="500"
        Background="#FFF3F3F3" AllowDrop="True" Closing="OnClosing" Loaded="OnLoaded"
        DragOver="OnDragOver" Drop="OnDrop" PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp">
  <DockPanel>
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem><TextBlock x:Name="DimensionsText" Text="No image" /></StatusBarItem>
      <Separator />
      <StatusBarItem><TextBlock x:Name="ZoomText" Text="100%" /></StatusBarItem>
      <Separator />
      <StatusBarItem><TextBlock x:Name="SelectionText" /></StatusBarItem>
    </StatusBar>
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#FFD0D0D0" BorderThickness="0,0,0,1" Padding="6">
      <WrapPanel KeyboardNavigation.TabNavigation="Local">
        <Button Content="Open" Click="Open_Click" ToolTip="Open (Ctrl+O)" AutomationProperties.Name="Open image" />
        <Button Content="Export" Click="Export_Click" ToolTip="Export (Ctrl+E)" AutomationProperties.Name="Export image" />
        <Separator Margin="6,0" />
        <Button x:Name="UndoButton" Content="Undo" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo" />
        <Button x:Name="RedoButton" Content="Redo" Click="Redo_Click" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo" />
        <Button Content="Resize" Click="Resize_Click" ToolTip="Resize (Ctrl+R)" AutomationProperties.Name="Resize image" />
        <Separator Margin="6,0" />
        <TextBlock Text="Crop" VerticalAlignment="Center" Margin="4" />
        <Button Content="1:1" Click="SquareCrop_Click" ToolTip="Square crop" AutomationProperties.Name="Square crop" />
        <Button Content="9:16" Click="PortraitCrop_Click" ToolTip="Portrait crop" AutomationProperties.Name="Portrait crop" />
        <Button Content="Free" Click="FreeCrop_Click" ToolTip="Free crop" AutomationProperties.Name="Free crop" />
        <Button x:Name="ApplyCropButton" Content="Crop" Click="ApplyCrop_Click" ToolTip="Crop (Enter)" AutomationProperties.Name="Crop image" />
        <Separator Margin="6,0" />
        <Button Content="−" Click="ZoomOut_Click" ToolTip="Zoom out (Ctrl+-)" AutomationProperties.Name="Zoom out" />
        <Button Content="+" Click="ZoomIn_Click" ToolTip="Zoom in (Ctrl+=)" AutomationProperties.Name="Zoom in" />
        <Button Content="Fit" Click="Fit_Click" ToolTip="Zoom to fit (Ctrl+0)" AutomationProperties.Name="Zoom to fit" />
        <Button Content="100%" Click="Actual_Click" ToolTip="Actual pixels (Ctrl+1)" AutomationProperties.Name="Actual pixels" />
        <Separator Margin="6,0" />
        <Button x:Name="AltTextButton" Content="Generate alt text" Click="AltText_Click" ToolTip="Generate alt text (Ctrl+G)" AutomationProperties.Name="Generate alt text" />
        <Button Content="Settings" Click="Settings_Click" ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Settings" />
      </WrapPanel>
    </Border>
    <Grid Background="#FFCACACA">
      <TextBlock x:Name="EmptyMessage" Text="Open an image or drop one here" FontSize="22" Foreground="#FF555555"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
      <ScrollViewer x:Name="CanvasScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    PreviewMouseWheel="CanvasScroller_OnPreviewMouseWheel" PreviewMouseDown="CanvasScroller_OnPreviewMouseDown"
                    PreviewMouseMove="CanvasScroller_OnPreviewMouseMove" PreviewMouseUp="CanvasScroller_OnPreviewMouseUp">
        <controls:ImageCanvas x:Name="Canvas" Focusable="True"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
